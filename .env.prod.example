# Production environment for Voice RAG — copy to .env.prod and fill real values.
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

APP_ENV=production
REQUIRE_ACTIVE_INDEX=true

API_PORT=8000
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBED_DEVICE=cpu

POSTGRES_USER=voice_rag
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=voice_rag

# HuggingFace read token (gated MSMARCO-XI repo): https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# OpenCode Go (open models): https://opencode.ai/auth
OPENCODE_GO_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-flash

# ElevenLabs (voice STT): https://elevenlabs.io
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

WEB_RESEARCH_ENABLED=false
INDEX_BATCH_SIZE=64