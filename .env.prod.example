# Production environment for Voice RAG.
# For Render, enter the secret values in the Blueprint prompt.
# For Docker, copy this file to .env.prod and fill every CHANGE_ME value.

APP_ENV=production
REQUIRE_ACTIVE_INDEX=true

API_PORT=8000
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBED_DEVICE=cpu

# The password's '@' must be URL-encoded as %40 inside a DSN.
DATABASE_URL=postgresql://postgres:CHANGE_ME%40PASSWORD@db.example.supabase.co:5432/postgres?sslmode=require

# HuggingFace read token (gated MSMARCO-XI repo): https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# OpenCode Go (open models): https://opencode.ai/auth
OPENCODE_GO_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-flash

# ElevenLabs (voice STT): https://elevenlabs.io
ELEVENLABS_API_KEY=CHANGE_ME

# External production Qdrant cluster.
QDRANT_URL=https://CHANGE_ME.qdrant.io
QDRANT_API_KEY=CHANGE_ME
QDRANT_COLLECTION=voice_rag_active

# Existing Vercel frontend.
CORS_ORIGINS=https://hh-goa-voice-olive.vercel.app
INDEX_VERSION=production
TRACE_PATH=/tmp/voice-rag-traces.jsonl

WEB_RESEARCH_ENABLED=false
INDEX_BATCH_SIZE=64
