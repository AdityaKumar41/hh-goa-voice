APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ELEVENLABS_API_KEY=
ELEVENLABS_STT_URL=https://api.elevenlabs.io/v1/speech-to-text
ELEVENLABS_STT_MODEL=scribe_v2
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-flash
# Required for ingestion: MSMARCO-XI is a gated repo. Create a read token at
# https://huggingface.co/settings/tokens
HF_TOKEN=
POSTGRES_DSN=postgresql://voice_rag:voice_rag@127.0.0.1:5432/voice_rag
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=voice_rag_active
REQUIRE_ACTIVE_INDEX=false
INDEX_BATCH_SIZE=64
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# cpu keeps embed latency flat (no accelerator sleep spikes); mps/cuda allowed via env.
EMBED_DEVICE=cpu
INDEX_VERSION=dev
PROMPT_VERSION=research-v1
TRACE_PATH=data/traces.jsonl
MAX_AUDIO_BYTES=12000000
RETRIEVAL_TOP_K=8
MIN_RETRIEVAL_SCORE=0.20
MIN_ANSWER_OVERLAP=0.12
MAX_CONTEXT_CHARS=12000
# Answer mode: "normal" = hosted LLM (best quality, generation is a separate latency budget);
# "fast" = local extractive answer, whole retrieve+answer path fits <200ms.
ANSWER_MODE=normal
MAX_ANSWER_CHARS=900
REQUEST_TIMEOUT_SECONDS=20
WEB_RESEARCH_ENABLED=false
JINA_READER_URL=https://r.jina.ai
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
WEB_TIMEOUT_SECONDS=15
MAX_WEB_CHARS=20000
